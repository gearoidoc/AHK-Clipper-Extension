{
  "about": "Shared by extension/test/hotstring.test.ts (toHotstring must produce each line) and host/hotstring_test.go (the host must accept each line, and reject every entry in 'rejected').",
  "lines": [
    {"name": "plain text uses text mode", "trigger": ";brb", "text": "be right back", "options": {}, "line": ":T:;brb::be right back"},
    {"name": "backticks are doubled", "trigger": ";bt", "text": "use `code`", "options": {}, "line": ":T:;bt::use ``code``"},
    {"name": "semicolon after a space is escaped", "trigger": ";sc", "text": "a ;b", "options": {}, "line": ":T:;sc::a `;b"},
    {"name": "semicolon after a letter is left alone", "trigger": ";sc", "text": "a;b", "options": {}, "line": ":T:;sc::a;b"},
    {"name": "Send specials stay literal in text mode", "trigger": ";keys", "text": "{Enter}^c!#+", "options": {}, "line": ":T:;keys::{Enter}^c!#+"},
    {"name": "a lone brace is safe in text mode", "trigger": ";br", "text": "{", "options": {}, "line": ":T:;br::{"},
    {"name": "\"::\" inside the text is fine", "trigger": ";dc", "text": "a::b", "options": {}, "line": ":T:;dc::a::b"},
    {"name": "double quotes are literal in text mode", "trigger": ";q", "text": "say \"hi\"", "options": {}, "line": ":T:;q::say \"hi\""},
    {"name": "leading space goes to execute mode", "trigger": ";ls", "text": " indented", "options": {}, "line": ":X:;ls::SendText(\" indented\" A_EndChar)"},
    {"name": "trailing space goes to execute mode", "trigger": ";ts", "text": "end ", "options": {}, "line": ":X:;ts::SendText(\"end \" A_EndChar)"},
    {"name": "whitespace-only text goes to execute mode", "trigger": ";sp", "text": "   ", "options": {}, "line": ":X:;sp::SendText(\"   \" A_EndChar)"},
    {"name": "tabs go to execute mode as `t", "trigger": ";tab", "text": "a\tb", "options": {}, "line": ":X:;tab::SendText(\"a`tb\" A_EndChar)"},
    {"name": "multi-line uses `n", "trigger": ";sig", "text": "Best regards,\nJane", "options": {}, "line": ":X:;sig::SendText(\"Best regards,`nJane\" A_EndChar)"},
    {"name": "CRLF and lone CR become `n", "trigger": ";nl", "text": "a\r\nb\rc", "options": {}, "line": ":X:;nl::SendText(\"a`nb`nc\" A_EndChar)"},
    {"name": "quotes are escaped in a literal", "trigger": ";qq", "text": "say \"hi\"\nbye", "options": {}, "line": ":X:;qq::SendText(\"say `\"hi`\"`nbye\" A_EndChar)"},
    {"name": "backticks are doubled in a literal", "trigger": ";bq", "text": "a`b\nc", "options": {}, "line": ":X:;bq::SendText(\"a``b`nc\" A_EndChar)"},
    {"name": "comment semicolons are escaped in a literal", "trigger": ";sl", "text": "a ;b\nc", "options": {}, "line": ":X:;sl::SendText(\"a `;b`nc\" A_EndChar)"},
    {"name": "smart quotes become ASCII", "trigger": ";sq", "text": "\u201cit\u2019s\u201d", "options": {}, "line": ":T:;sq::\"it's\""},
    {"name": "non-breaking spaces become spaces", "trigger": ";nb", "text": "a\u00a0b\u202fc", "options": {}, "line": ":T:;nb::a b c"},
    {"name": "invisible characters are removed", "trigger": ";zw", "text": "a\u200bb\u00adc\ufeff", "options": {}, "line": ":T:;zw::abc"},
    {"name": "zero-width joiners in emoji survive", "trigger": ";dev", "text": "\ud83d\udc69\u200d\ud83d\udcbb", "options": {}, "line": ":T:;dev::\ud83d\udc69\u200d\ud83d\udcbb"},
    {"name": "colons in the trigger are escaped", "trigger": "a:b", "text": "x", "options": {}, "line": ":T:a`:b::x"},
    {"name": "a trailing colon in the trigger is escaped", "trigger": "x:", "text": "y", "options": {}, "line": ":T:x`:::y"},
    {"name": "backticks in the trigger are doubled", "trigger": "`t", "text": "y", "options": {}, "line": ":T:``t::y"},
    {"name": "comment semicolons in the trigger are escaped", "trigger": "a ;b", "text": "y", "options": {}, "line": ":T:a `;b::y"},
    {"name": "all options, text mode", "trigger": ";x", "text": "y", "options": {"immediate": true, "insideWord": true, "caseSensitive": true, "keepTrigger": true, "omitEndChar": true}, "line": ":*?CB0OT:;x::y"},
    {"name": "all options, execute mode", "trigger": ";x", "text": "y\nz", "options": {"immediate": true, "insideWord": true, "caseSensitive": true, "keepTrigger": true, "omitEndChar": true}, "line": ":*?CB0OX:;x::SendText(\"y`nz\")"},
    {"name": "execute mode with O drops A_EndChar", "trigger": ";x", "text": "y\nz", "options": {"omitEndChar": true}, "line": ":OX:;x::SendText(\"y`nz\")"},
    {"name": "execute mode with B0 drops A_EndChar", "trigger": ";x", "text": "y\nz", "options": {"keepTrigger": true}, "line": ":B0X:;x::SendText(\"y`nz\")"},
    {"name": "execute mode with * drops A_EndChar", "trigger": ";x", "text": "y\nz", "options": {"immediate": true}, "line": ":*X:;x::SendText(\"y`nz\")"},
    {"name": "? and C keep A_EndChar", "trigger": ";x", "text": "y\nz", "options": {"insideWord": true, "caseSensitive": true}, "line": ":?CX:;x::SendText(\"y`nz\" A_EndChar)"}
  ],
  "rejected": [
    {"name": "an arbitrary function call", "line": ":X:a::Run(\"calc\")"},
    {"name": "code after the literal", "line": ":X:a::SendText(\"x\") || Run(\"calc\")"},
    {"name": "a second statement", "line": ":X:a::SendText(\"x\"), Run(\"calc\")"},
    {"name": "code inside the call", "line": ":X:a::SendText(\"x\" Run(\"calc\"))"},
    {"name": "a variable instead of a literal", "line": ":X:a::SendText(A_Clipboard)"},
    {"name": "an unterminated literal", "line": ":X:a::SendText(\"a`\")"},
    {"name": "a doubled A_EndChar", "line": ":X:a::SendText(\"x\" A_EndChar A_EndChar)"},
    {"name": "no options, which defaults to whatever #Hotstring says", "line": "::a::text"},
    {"name": "raw mode", "line": ":R:a::text"},
    {"name": "options out of order", "line": ":OB0T:a::text"},
    {"name": "both T and X", "line": ":TX:a::text"},
    {"name": "C1", "line": ":C1T:a::text"},
    {"name": "an empty replacement, which starts a function body", "line": ":T:a::"},
    {"name": "leading space in text mode", "line": ":T:a:: text"},
    {"name": "trailing space in text mode", "line": ":T:a::text "},
    {"name": "an unpaired trailing backtick", "line": ":T:a::text`"},
    {"name": "a comment that would cut the line", "line": ":T:a::text ; comment"},
    {"name": "a tab comment", "line": ":X:a::SendText(\"x\")\t; comment"},
    {"name": "a line break", "line": ":T:a::text\r\nRun(\"calc\")"},
    {"name": "an empty trigger", "line": ":T:::text"},
    {"name": "a directive", "line": "#Include \"evil.ahk\""},
    {"name": "a plain code line", "line": "Run(\"calc\")"}
  ]
}
