{
  "manifest_version": 3,
  "name": "AHK Hotstring Clipper",
  "description": "Turn highlighted text into an AutoHotkey v2 hotstring. Local only: it talks to a native host on this PC and never to the network.",
  "key": "",
  "minimum_chrome_version": "130",
  "permissions": [
    "nativeMessaging",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-dialog": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Add the selected text as an AHK hotstring"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dialog.html"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'"
  }
}
